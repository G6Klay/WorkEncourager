<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Win10 1607 起系统自带 4.6.2 或更新的 .NET Framework，朋友的电脑不用装任何运行时。
      这也是 WebView2 包支持的最低版本。
    -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WorkEncourager</AssemblyName>
    <RootNamespace>WorkEncourager</RootNamespace>
    <Version>0.1.1</Version>
    <Product>上班鼓励器</Product>
    <AssemblyTitle>上班鼓励器</AssemblyTitle>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <!-- 不需要把 git 信息写进 exe，构建也就不依赖仓库配置 -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**</DefaultItemExcludes>
    <!-- Release 构建后只把一个 exe 复制到这里，所有依赖都内嵌在里面 -->
    <DistDir Condition="'$(DistDir)' == ''">dist\</DistDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
    <Reference Include="System.Web.Extensions" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- 内嵌 WebView2 依赖，见 src/EmbeddedDependencies.cs -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="deps/Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="deps/Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="loader/x64/WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" LogicalName="loader/x86/WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" LogicalName="loader/arm64/WebView2Loader.dll" />
  </ItemGroup>

  <Target Name="CopyExeToDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)" />
  </Target>

</Project>
